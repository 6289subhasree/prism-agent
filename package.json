    "test:api": "node scripts/test-api.js"
  },
  "dependencies": {
    "@agentrhq/webcmd": "0.7.8",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "express": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  }
}
