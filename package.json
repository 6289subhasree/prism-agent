{
  "name": "prism-privacy-agent",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"node server.js\" \"vite --host 127.0.0.1\"",
    "server": "node server.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prism:doctor": "node scripts/prism-doctor.js",
    "test": "node --test agent/*.test.js",
    "test:browser": "node --test tests/browser/*.test.js",
    "test:browser:install": "playwright-core install chromium --only-shell",
    "test:api": "node scripts/test-api.js",
    "prism:gemini": "node scripts/prism-gemini.js"
  },
  "dependencies": {
    "@agentrhq/webcmd": "0.7.8",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "express": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tldts": "7.4.11",
    "vite": "latest",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "playwright-core": "1.61.1"
  }
}
